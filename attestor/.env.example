# L{CORE} Attestor Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For docker-compose deployment, use the root .env.example instead.
# This file is for standalone attestor deployment.

# =============================================================================
# SERVER
# =============================================================================
PORT=8001
LOG_LEVEL=info
NODE_ENV=production
CORS_ALLOWED_ORIGINS=*

# =============================================================================
# WALLET (Required)
# =============================================================================
# Option 1: Mnemonic phrase (recommended for EigenCloud TEE)
MNEMONIC=

# Option 2: Direct private key (hex format, with or without 0x prefix)
# PRIVATE_KEY=

# =============================================================================
# L{CORE} CONFIGURATION (Required)
# =============================================================================
# Enable L{CORE} integration
LCORE_ENABLED=1

# Cartesi Node URL (for inspect queries)
# Example: http://localhost:10000 or http://your-cartesi-node:10000
LCORE_NODE_URL=

# Blockchain RPC URL (Arbitrum Sepolia)
# Get from: Alchemy, Infura, QuickNode
LCORE_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# DApp contract address (from `cartesi deploy` output)
LCORE_DAPP_ADDRESS=

# InputBox contract address (standard for Arbitrum Sepolia)
LCORE_INPUTBOX_ADDRESS=0x59b22D57D4f067708AB0c00552767405926dc768

# =============================================================================
# CARTESI NODE (Required)
# =============================================================================
# Proof signing key for Cartesi computation outputs (32-byte hex)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROOF_SIGNING_KEY=

# =============================================================================
# L{CORE} ENCRYPTION (Required)
# =============================================================================
# V1: Single NaCl keypair — private key lives ONLY in TEE (here).
# Public key is shared with Cartesi node (set via set_encryption_key advance).
#
# Generate keypair:
# node -e "const nacl=require('tweetnacl');const kp=nacl.box.keyPair();console.log('LCORE_PRIVATE_KEY='+Buffer.from(kp.secretKey).toString('base64'));console.log('LCORE_PUBLIC_KEY='+Buffer.from(kp.publicKey).toString('base64'))"
#
# Private key: Attestor TEE only (for encrypting inputs + decrypting outputs)
LCORE_PRIVATE_KEY=
# Public key: Shared with Cartesi node for output encryption
LCORE_PUBLIC_KEY=

# =============================================================================
# DATABASE (Optional - required for admin dashboard)
# =============================================================================
# Supabase connection for admin auth, API keys, and audit logging.
# Not required for core attestation functionality.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# JWT secret for admin session tokens (generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
